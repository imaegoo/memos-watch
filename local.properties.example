# Copy to local.properties and fill in. This file is not committed.
sdk.dir=/path/to/Android/Sdk

# Memos server base URL, no trailing slash.
MEMOS_BASE_URL=https://your-memos.example.com
# Access token created in Memos: Settings -> Access Tokens.
MEMOS_TOKEN=your_access_token

# Optional: release signing. Without these the release APK is unsigned.
RELEASE_STORE_FILE=/path/to/keystore.jks
RELEASE_STORE_PASSWORD=your_store_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
